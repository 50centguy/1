  customerStatement: "\u4FE1\u6807\u6700\u8FD1\u597D\u50CF\u6709\u70B9\u6BDB\u75C5\uFF0C\u4F60\u5E2E\u6211\u6062\u590D\u4E00\u4E0B\u51FA\u5382\u8BBE\u7F6E\u5C31\u884C\uFF0C\u522B\u7684\u4E0D\u7528\u591A\u95EE\u3002\u94B1\u4E0D\u662F\u95EE\u9898\u3002"
  intakeNote: "\u5916\u89C2\u5B8C\u597D\u3002\u6309\u89C4\u5B9A\uFF0C\u8FB9\u5883\u5BFC\u822A\u8BBE\u5907\u7684\u68C0\u4FEE\u5C01\u7B7E\u5FC5\u987B\u5B8C\u6574\u3002"
