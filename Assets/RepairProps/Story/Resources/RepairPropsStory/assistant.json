{
  "groups": [
    {
      "key": "purchase-received",
      "lines": [
        {
          "face": "Happy",
          "text": "采购单收到。货到了柜台交付口，我去搬。"
        }
      ]
    },
    {
      "key": "greet",
      "lines": [
        {
          "face": "Happy",
          "text": "晚上好，老板。UNIT-07 通电正常。"
        },
        {
          "face": "Smile",
          "text": "今天也是搬货我来，动手你来。有事看我一眼——左键点我。"
        }
      ]
    },
    {
      "key": "first-item",
      "lines": [
        {
          "face": "Smile",
          "text": "第一件上台了。我在这边待命。拆下来的螺丝别乱放。"
        }
      ]
    },
    {
      "key": "retest-failed",
      "lines": [
        {
          "face": "Worry",
          "text": "复测没过。检查接线和螺丝数量。少一颗的概率比较高。"
        }
      ]
    },
    {
      "key": "all-done",
      "lines": [
        {
          "face": "Worry",
          "text": "……左引擎温度偏高 3 度。还在允许范围内。"
        },
        {
          "face": "Smile",
          "text": "老板，去记账吧。"
        }
      ]
    },
    {
      "key": "after-call:rent-n1",
      "lines": [
        {
          "face": "Talk",
          "text": "房东小姐的通话时长为 14 秒。"
        },
        {
          "face": "Smile",
          "text": "另外，我身上的原厂合规防拆封条共七张，目前全部完好。"
        }
      ]
    },
    {
      "key": "after-call:dealer-intro",
      "lines": [
        {
          "face": "Worry",
          "text": "检索完成。Frankie 先生的库存清单里，有 42% 的零件登记在已倒闭厂商的报废表上。"
        }
      ]
    },
    {
      "key": "after-call:patrol-receiver",
      "lines": [
        {
          "face": "Signal",
          "text": "02:10 的那个应答，我在公共频段上也收到了。呼号 12-B。"
        },
        {
          "face": "Smile",
          "text": "它每晚都很准时。"
        }
      ]
    },
    {
      "key": "after-call:dealer-cartridge",
      "lines": [
        {
          "face": "Worry",
          "text": "老式重型义手已经全部淘汰。"
        },
        {
          "face": "Worry",
          "text": "……老板，要是哪天我也到报废年限了，会不会也有人把我的操作记录拆下来卖？"
        },
        {
          "face": "Smile",
          "text": "开玩笑的。先把今天的单子做完吧。"
        }
      ]
    },
    {
      "key": "after-call:care-omamori",
      "lines": [
        {
          "face": "Smile",
          "text": "型号为“小绿”的旧看护机，比我还早两代。厂家停服了，它还亮着。"
        }
      ]
    },
    {
      "key": "parts-delivered",
      "lines": [
        {
          "face": "Happy",
          "text": "配件放到维修台右手边了。签收：七号。"
        }
      ]
    }
  ],
  "hints": [
    {
      "key": "hint-busy",
      "text": "我在搬货，马上回来。"
    },
    {
      "key": "hint-carrying",
      "text": "放到维修台上就行。我帮你看着路。"
    },
    {
      "key": "hint-pending-case",
      "text": "柜台接收区有新单子。"
    },
    {
      "key": "hint-in-repair",
      "text": "台上那件还没修完。缺配件就开采购单，我去搬。"
    },
    {
      "key": "hint-ready-for-delivery",
      "text": "修好的东西该交给客人了。去柜台交付区。"
    }
  ],
  "banter": [
    "我的托盘承重四公斤。今晚最重的是那台电源。",
    "转子转速正常。你的手很稳。",
    "屏幕上的笑脸是出厂设置。不过我挺喜欢的。",
    "公共频段今晚很安静。安静得有点不对。"
  ],
  "banterAfterCall": [
    {
      "afterCall": "patrol-receiver",
      "text": "02:10 快到了吗？……我只是在看时间。"
    },
    {
      "afterCall": "care-omamori",
      "text": "刚刚扫到照护站频段。“小绿”发了一次心跳包，运行正常。"
    }
  ]
}
